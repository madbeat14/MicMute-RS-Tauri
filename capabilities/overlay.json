{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "overlay",
    "description": "Capabilities for overlay windows",
    "platforms": [
        "windows"
    ],
    "windows": [
        "overlay",
        "overlay-*"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-outer-position",
        "core:window:allow-set-size",
        "core:window:allow-set-always-on-top"
    ]
}
